--cpu Cortex-M3
"dht20\startup_stm32f103xb.o"
"dht20\main.o"
"dht20\gpio.o"
"dht20\dma.o"
"dht20\i2c.o"
"dht20\usart.o"
"dht20\stm32f1xx_it.o"
"dht20\stm32f1xx_hal_msp.o"
"dht20\stm32f1xx_hal_gpio_ex.o"
"dht20\stm32f1xx_hal_i2c.o"
"dht20\stm32f1xx_hal.o"
"dht20\stm32f1xx_hal_rcc.o"
"dht20\stm32f1xx_hal_rcc_ex.o"
"dht20\stm32f1xx_hal_gpio.o"
"dht20\stm32f1xx_hal_dma.o"
"dht20\stm32f1xx_hal_cortex.o"
"dht20\stm32f1xx_hal_pwr.o"
"dht20\stm32f1xx_hal_flash.o"
"dht20\stm32f1xx_hal_flash_ex.o"
"dht20\stm32f1xx_hal_exti.o"
"dht20\stm32f1xx_hal_uart.o"
"dht20\system_stm32f1xx.o"
